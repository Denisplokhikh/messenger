# Скопируйте в .env для локальной разработки: cp .env.example .env
# В проде (Coolify) эти же переменные задаются в UI ресурса → Environment Variables.
# Обязательные в проде: POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, SECRET_KEY, MESSAGE_ENCRYPTION_KEY, ATTACHMENT_ENCRYPTION_KEY

PROJECT_NAME="FastAPI Messenger"
DEBUG=True

# Database (PostgreSQL)
# localhost — для запуска uvicorn/pytest на хосте; в docker compose переопределяется на db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=messenger_db

# Security & JWT. Для прода сгенерируйте свой:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=supersecretjwtsecretkeyreplaceinproduction987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Message encryption at rest (Fernet). Generate your own:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потеря ключа = потеря всех сообщений: храните копию вне сервера, вместе с бэкапами БД
MESSAGE_ENCRYPTION_KEY=

# Attachment files encryption at rest (AES-256-GCM, 32 bytes). Generate your own:
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Потеря ключа = потеря всех вложений, храните копию так же, как MESSAGE_ENCRYPTION_KEY
ATTACHMENT_ENCRYPTION_KEY=
